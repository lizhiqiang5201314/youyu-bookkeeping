# 阿里云短信服务配置
# 请将以下配置填入对应的环境变量

# 阿里云RAM用户AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# 短信签名（在阿里云申请，如"艺林美育"）
SMS_SIGN_NAME=艺林美育

# 短信模板CODE（在阿里云申请后获得）
# 模板内容示例：您的验证码是${code}，5分钟内有效。
SMS_TEMPLATE_CODE=SMS_12345678

# 验证码有效期（分钟）
SMS_CODE_EXPIRE_MINUTES=5

# 每日每个手机号最大发送次数
SMS_MAX_DAILY_SEND=10
