# 阿里云短信服务配置
# 请将以下配置填入对应的环境变量
# Supabase Edge Functions 部署时，请使用 `supabase secrets set --env-file .env.sms.example`
# 或在 Supabase 控制台为 `sms-auth` 配置同名 secrets

# 阿里云RAM用户AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# 短信发送区域，国内验证码一般使用 cn-hangzhou
SMS_REGION_ID=cn-hangzhou

# 可选：自定义短信服务 endpoint，通常留空即可
SMS_ENDPOINT=

# 短信签名（在阿里云申请，如"艺林美育"）
SMS_SIGN_NAME=艺林美育

# 短信模板CODE（在阿里云申请后获得）
# 模板内容示例：您的验证码是${code}，5分钟内有效。
SMS_TEMPLATE_CODE=SMS_12345678

# 短信模板变量名，默认使用 code
SMS_TEMPLATE_PARAM_KEY=code

# 验证码有效期（分钟）
SMS_CODE_EXPIRE_MINUTES=5

# 本地调试时可开启，前端会直接收到验证码；生产环境请保持 false
SMS_DEBUG_MODE=false
