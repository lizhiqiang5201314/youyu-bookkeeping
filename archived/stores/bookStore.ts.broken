import { create } from 'zustand';
import { persist } from 'zustand/middleware';
import { storage } from '@/services/storage';
import { supabase } from '@/services/supabase';
import { db } from '@/services/db';
import type { Book, Category, BookMember, BookType, BookInvite } from '@/types';
import { BUILTIN_EXPENSE_CATEGORIES, BUILTIN_INCOME_CATEGORIES } from '@/utils/constants';
import { useSubscriptionStore } from './subscriptionStore';
import { toast } from 'sonner';

interface BookState {
  books: Book[];
  currentBook: Book | null;
  categories: Category[];
  isLoading: boolean;
  isSyncing: boolean;
  deletedBookIds: Set<string>; // 已删除的账本ID，防止同步时恢复
  
  // Actions
  fetchBooks: (userId: string) => Promise<void>;
  createBook: (name: string, type: BookType, userId: string) => Promise<Book | null>;
  setCurrentBook: (book: Book) => void;
  updateBook: (bookId: string, data: Partial<Book>) => Promise<void>;
  deleteBook: (bookId: string) => Promise<void>;
  exitBook: (bookId: string, userId: string) => Promise<boolean>;
  addMember: (bookId: string, member: BookMember) => Promise<void>;
  removeMember: (bookId: string, userId: string) => Promise<void>;
  
  // 邀请相关
  generateInviteCode: (bookId: string, userId: string) => Promise<string | null>;
  joinBookByCode: (code: string, userId: string) => Promise<Book | null>;
  
  // Category actions
  fetchCategories: (bookId: string) => Promise<void>;
  addCategory: (category: Omit<Category, 'id' | 'bookId'>) => Promise<void>;
  updateCategory: (categoryId: string, data: Partial<Category>) => Promise<void>;
  deleteCategory: (categoryId: string) => Promise<void>;
  getCategoriesByType: (type: 'INCOME' | 'EXPENSE') => Category[];
  
  // Init
  initDefaultBook: (userId: string) => Promise<void>;
  
  // Sync
  syncWithCloud: (userId: string) => Promise<void>;
  
  // 会员相关
  canCreateBookType: (userId: string, type: BookType) => { canCreate: boolean; message?: string };
  getUserBooksByType: (userId: string, type: BookType) => Book[];
  
  // 权限检查
  isBookOwner: (bookId: string, userId: string) => boolean;
  isBookMember: (bookId: string, userId: string) => boolean;
  canModifyBook: (bookId: string, userId: string) => boolean;
}

export const useBookStore = create<BookState>()(
  persist(
    (set, get) => ({
      books: [],
      currentBook: null,
      categories: [],
      isLoading: false,
      isSyncing: false,
      deletedBookIds: new Set<string>(),

      // 检查用户是否可以创建某类型账本
      canCreateBookType: (userId: string, type: BookType) => {
        const { books } = get();
        const userBooks = books.filter(b => b.createdBy === userId);
        
        // 检查是否已有该类型账本（每种类型只能有一个）
        const existingBook = userBooks.find(b => b.type === type);
        if (existingBook) {
          return { 
            canCreate: false, 
            message: `您已有一个${type === 'COUPLE' ? '情侣' : type === 'FAMILY' ? '家庭' : '个人'}账本了` 
          };
        }
        
        // 个人账本：免费，只能有1个
        if (type === 'PERSONAL') {
          const personalCount = userBooks.filter(b => b.type === 'PERSONAL').length;
          if (personalCount >= 1) {
            return { canCreate: false, message: '免费用户只能有一个个人账本' };
          }
          return { canCreate: true };
        }
        
        // 情侣账本：需要情侣会员
        if (type === 'COUPLE') {
          const subscriptionStore = useSubscriptionStore.getState();
          const isCoupleActive = subscriptionStore.isSubscriptionActive(userId, 'COUPLE');
          if (!isCoupleActive) {
            return { canCreate: false, message: '需要开通情侣会员才能创建情侣账本' };
          }
          return { canCreate: true };
        }
        
        // 家庭账本：需要家庭会员
        if (type === 'FAMILY') {
          const subscriptionStore = useSubscriptionStore.getState();
          const isFamilyActive = subscriptionStore.isSubscriptionActive(userId, 'FAMILY');
          if (!isFamilyActive) {
            return { canCreate: false, message: '需要开通家庭会员才能创建家庭账本' };
          }
          return { canCreate: true };
        }
        
        return { canCreate: false, message: '未知的账本类型' };
      },

      // 获取用户某类型的账本
      getUserBooksByType: (userId: string, type: BookType) => {
        return get().books.filter(b => b.createdBy === userId && b.type === type);
      },

      fetchBooks: async (userId: string) => {
        if (!userId) return;
        set({ isLoading: true });

        try {
          // 1. 先加载本地数据（快速响应）
          const localBooks = await db.books.toArray();
          
          // 筛选出用户的账本（创建的或作为成员的）
          const userLocalBooks = localBooks.filter(b => {
            const isCreator = b.createdBy === userId;
            const isMember = (b.members || []).some(m => m.userId === userId);
            return isCreator || isMember;
          });
          
          if (userLocalBooks.length > 0) {
            const books = userLocalBooks.map(b => ({
              id: b.id,
              name: b.name,
              type: b.type,
              currency: b.currency || 'CNY',
              createdAt: b.createdAt,
              createdBy: b.createdBy,
              members: b.members || [],
            }));
            set({ 
              books,
              currentBook: get().currentBook || books[0] || null,
            });
          }

          // 2. 后台同步云端数据（等待完成）
          await get().syncWithCloud(userId);
        } finally {
          set({ isLoading: false });
        }
      },

      syncWithCloud: async (userId: string) => {
        if (get().isSyncing) return;
        set({ isSyncing: true });

        try {
          // 获取云端账本
          const { data: booksData } = await supabase
            .from('books')
            .select('*')
            .eq('created_by', userId);

          const { data: memberData } = await supabase
            .from('book_members')
            .select('book_id')
            .eq('user_id', userId);

          let allBooks = booksData || [];
          
          // 过滤掉已删除的账本
          const { deletedBookIds } = get();
          allBooks = allBooks.filter((b: any) => !deletedBookIds.has(b.id));
          
          if (memberData && memberData.length > 0) {
            const bookIds = memberData.map((m: any) => m.book_id);
            const { data: sharedBooks } = await supabase
              .from('books')
              .select('*')
              .in('id', bookIds);
            
            if (sharedBooks) {
              // 过滤掉已删除的共享账本
              const filteredSharedBooks = sharedBooks.filter((b: any) => !deletedBookIds.has(b.id));
              allBooks = [...allBooks, ...filteredSharedBooks];
            }
          }

          // 获取所有账本的成员
          const bookIds = allBooks.map((b: any) => b.id);
          const { data: allMembers } = await supabase
            .from('book_members')
            .select('*')
            .in('book_id', bookIds);

          const membersByBook: Record<string, BookMember[]> = {};
          if (allMembers) {
            allMembers.forEach((m: any) => {
              if (!membersByBook[m.book_id]) {
                membersByBook[m.book_id] = [];
              }
              membersByBook[m.book_id].push({
                userId: m.user_id,
                role: m.role,
                joinedAt: m.joined_at,
              });
            });
          }

          const cloudBooks: Book[] = (allBooks as any[]).map((b: any) => ({
            id: b.id,
            name: b.name,
            type: b.type as BookType,
            currency: 'CNY',
            createdAt: b.created_at,
            createdBy: b.created_by,
            members: membersByBook[b.id] || [],
          }));

          // 合并本地和云端数据
          const localBooks = await db.books.toArray();
          const localBookIds = new Set(localBooks.map(b => b.id));
          
          // 云端有的本地没有 → 添加到本地
          for (const book of cloudBooks) {
            if (!localBookIds.has(book.id)) {
              await db.books.put({
                ...book,
                synced: true,
                lastModified: Date.now(),
              });
            }
          }

          // 更新状态 - 只显示当前用户的账本
          const currentUserBooks = cloudBooks.filter(b => b.createdBy === userId);
          const sharedBooks = cloudBooks.filter(b => b.createdBy !== userId);
          
          set({ 
            books: [...currentUserBooks, ...sharedBooks],
            currentBook: get().currentBook || currentUserBooks[0] || null,
          });

          // 如果有当前账本，加载分类
          if (currentUserBooks[0]) {
            await get().fetchCategories(currentUserBooks[0].id);
          }
        } catch (error) {
          console.error('Sync error:', error);
        } finally {
          set({ isSyncing: false });
        }
      },

      createBook: async (name, type, userId) => {
        if (!userId) return null;

        // 检查是否可以创建该类型账本
        const { canCreate, message } = get().canCreateBookType(userId, type);
        if (!canCreate) {
          console.error('无法创建账本:', message);
          return null;
        }

        // 根据类型设置默认名称
        let bookName = name;
        if (!bookName) {
          if (type === 'PERSONAL') bookName = '个人账本';
          else if (type === 'COUPLE') bookName = '情侣账本';
          else if (type === 'FAMILY') bookName = '家庭账本';
        }

        const book: Book = {
          id: crypto.randomUUID(),
          name: bookName,
          type,
          currency: 'CNY',
          createdAt: new Date().toISOString(),
          createdBy: userId,
          members: [],
        };

        // 1. 先存本地（即时响应）
        await db.books.put({
          ...book,
          synced: false,
          lastModified: Date.now(),
        });

        // 2. 立即创建默认分类（同步，确保分类存在）
        const defaultCategories = [
          ...BUILTIN_EXPENSE_CATEGORIES.map((cat, index) => ({
            id: crypto.randomUUID(),
            bookId: book.id,
            name: cat.name,
            type: 'EXPENSE' as const,
            icon: cat.icon,
            color: cat.color,
            sortOrder: index,
            isBuiltin: true,
          })),
          ...BUILTIN_INCOME_CATEGORIES.map((cat, index) => ({
            id: crypto.randomUUID(),
            bookId: book.id,
            name: cat.name,
            type: 'INCOME' as const,
            icon: cat.icon,
            color: cat.color,
            sortOrder: index,
            isBuiltin: true,
          })),
        ];

        for (const cat of defaultCategories) {
          await db.categories.put({ ...cat, synced: false, lastModified: Date.now() });
        }

        // 3. 更新状态（此时分类已存在）
        set(state => ({
          books: [...state.books, book],
          currentBook: book,
          categories: defaultCategories,
        }));

        // 4. 后台同步云端（不阻塞）
        (async () => {
          try {
            const { data: bookData, error } = await supabase
              .from('books')
              .insert({
                id: book.id,
                name: book.name,
                type,
                created_by: userId,
              })
              .select()
              .single();

            if (!error && bookData) {
              await db.books.update(book.id, { synced: true });
            }

            // 同步分类到云端
            await supabase.from('categories').insert(
              defaultCategories.map(c => ({
                id: c.id,
                book_id: c.bookId,
                name: c.name,
                type: c.type,
                icon: c.icon,
                color: c.color,
                sort_order: c.sortOrder,
                is_builtin: c.isBuiltin,
              }))
            );

            await get().fetchCategories(book.id);
          } catch (error) {
            console.error('Sync book to cloud error:', error);
          }
        })();

        return book;
      },

      setCurrentBook: (book) => {
        set({ currentBook: book });
        if (book) {
          get().fetchCategories(book.id);
        }
      },

      updateBook: async (bookId, data) => {
        // 更新本地
        await db.books.update(bookId, {
          ...data,
          synced: false,
          lastModified: Date.now(),
        });

        set(state => ({
          books: state.books.map(book =>
            book.id === bookId ? { ...book, ...data } : book
          ),
          currentBook: state.currentBook?.id === bookId
            ? { ...state.currentBook, ...data }
            : state.currentBook,
        }));

        // 后台同步云端（不阻塞）
        (async () => {
          try {
            await supabase.from('books').update(data).eq('id', bookId);
            await db.books.update(bookId, { synced: true });
          } catch (error) {
            console.error('Update book sync error:', error);
          }
        })();
      },

      deleteBook: async (bookId) => {
        // 先添加到删除标记集合，防止同步时恢复
        set(state => ({
          deletedBookIds: new Set([...state.deletedBookIds, bookId])
        }));

        // 删除本地
        await db.books.delete(bookId);
        await db.categories.where('bookId').equals(bookId).delete();
        await db.transactions.where('bookId').equals(bookId).delete();

        set(state => ({
          books: state.books.filter(book => book.id !== bookId),
          categories: state.categories.filter(cat => cat.bookId !== bookId),
          currentBook: state.currentBook?.id === bookId
            ? state.books.find(b => b.id !== bookId) || null
            : state.currentBook,
        }));

        // 后台同步云端（不阻塞）
        (async () => {
          try {
            // 先删除账本成员关系
            await supabase.from('book_members').delete().eq('book_id', bookId);
            // 再删除账本（Supabase 会级联删除其他关联数据）
            await supabase.from('books').delete().eq('id', bookId);
            console.log('Book and members deleted from cloud:', bookId);
          } catch (error) {
            console.error('Delete book sync error:', error);
          }
        })();
      },

      // 退出账本（用于成员退出情侣/家庭账本）
      exitBook: async (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        if (!book) return false;

        // 如果是创建者，不能直接退出，只能删除
        if (book.createdBy === userId) {
          console.error('创建者不能退出，只能删除账本');
          return false;
        }

        // 从本地状态中移除自己
        set(state => ({
          books: state.books.map(b =>
            b.id === bookId
              ? { ...b, members: b.members.filter(m => m.userId !== userId) }
              : b
          ),
          currentBook: state.currentBook?.id === bookId
            ? state.books.find(b => b.id !== bookId) || null
            : state.currentBook,
        }));

        // 同步云端
        try {
          await supabase
            .from('book_members')
            .delete()
            .eq('book_id', bookId)
            .eq('user_id', userId);
          return true;
        } catch (error) {
          console.error('Exit book error:', error);
          return false;
        }
      },

      addMember: async (bookId, member) => {
        // TODO: 云端同步
        set(state => ({
          books: state.books.map(book =>
            book.id === bookId
              ? { ...book, members: [...book.members, member] }
              : book
          ),
        }));
      },

      removeMember: async (bookId, userId) => {
        // TODO: 云端同步
        set(state => ({
          books: state.books.map(book =>
            book.id === bookId
              ? { ...book, members: book.members.filter(m => m.userId !== userId) }
              : book
          ),
        }));
      },

      // 生成邀请码
      generateInviteCode: async (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        if (!book) {
          console.error('账本不存在:', bookId);
          toast.error('账本不存在');
          return null;
        }
        if (book.createdBy !== userId) {
          console.error('只有账本创建者才能生成邀请码:', book.createdBy, '!=', userId);
          toast.error('只有账本创建者才能生成邀请码');
          return null;
        }

        // 检查账本类型
        if (book.type === 'PERSONAL') {
          console.error('个人账本不能邀请成员');
          toast.error('个人账本不能邀请成员');
          return null;
        }

        // 检查当前成员数
        const currentMembers = book.members.length + 1; // +1 为创建者
        const maxMembers = book.type === 'COUPLE' ? 2 : book.type === 'FAMILY' ? 5 : 1;
        if (currentMembers >= maxMembers) {
          console.error('账本成员已满:', currentMembers, '/', maxMembers);
          toast.error('账本成员已满');
          return null;
        }

        // 生成6位数字邀请码
        const code = Math.floor(100000 + Math.random() * 900000).toString();
        const now = new Date();
        const expiresAt = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000); // 7天有效期

        const invite: BookInvite = {
          id: crypto.randomUUID(),
          bookId,
          code,
          createdBy: userId,
          createdAt: now.toISOString(),
          expiresAt: expiresAt.toISOString(),
          maxUses: 1,
          usedCount: 0,
        };

        try {
          // 存本地
          await db.bookInvites?.put(invite);

          // 同步云端
          console.log('Inserting invite to Supabase:', invite);
          const { data, error } = await supabase.from('book_invites').insert({
            id: invite.id,
            book_id: invite.bookId,
            code: invite.code,
            created_by: invite.createdBy,
            created_at: invite.createdAt,
            expires_at: invite.expiresAt,
            max_uses: invite.maxUses,
            used_count: invite.usedCount,
          }).select();

          if (error) {
            console.error('Create invite error:', error);
            toast.error(`创建邀请码失败: ${error.message}`);
            return null;
          }

          console.log('Invite created successfully:', data);
          return code;
        } catch (error: any) {
          console.error('Generate invite code error:', error);
          toast.error(`生成邀请码失败: ${error?.message || '未知错误'}`);
          return null;
        }
      },

      // 通过邀请码加入账本
      joinBookByCode: async (code: string, userId: string) => {
        try {
          console.log('Joining book with code:', code, 'userId:', userId);
          
          // 查询邀请码
          const { data: inviteData, error: inviteError } = await supabase
            .from('book_invites')
            .select('*')
            .eq('code', code.trim())
            .single();

          if (inviteError) {
            console.error('Query invite error:', inviteError);
            toast.error('邀请码无效');
            return null;
          }
          
          if (!inviteData) {
            console.error('Invalid invite code: no data found');
            toast.error('邀请码无效');
            return null;
          }

          console.log('Found invite:', inviteData);

          const invite: BookInvite = {
            id: inviteData.id,
            bookId: inviteData.book_id,
            code: inviteData.code,
            createdBy: inviteData.created_by,
            createdAt: inviteData.created_at,
            expiresAt: inviteData.expires_at,
            maxUses: inviteData.max_uses,
            usedCount: inviteData.used_count,
          };

          // 检查是否过期
          const now = new Date();
          const expiresAt = new Date(invite.expiresAt);
          console.log('Checking expiry:', now, 'vs', expiresAt);
          if (expiresAt < now) {
            console.error('Invite code expired');
            toast.error('邀请码已过期');
            return null;
          }

          // 检查是否已达最大使用次数
          if (invite.maxUses && invite.usedCount >= invite.maxUses) {
            console.error('Invite code has been used');
            toast.error('邀请码已被使用');
            return null;
          }

          // 检查是否已经在账本中（包括作为创建者）
          let book = get().books.find(b => b.id === invite.bookId);
          console.log('Found book:', book?.name, 'createdBy:', book?.createdBy);
          
          // 如果本地没有，尝试从云端获取账本信息
          if (!book) {
            const { data: bookData, error: bookError } = await supabase
              .from('books')
              .select('*')
              .eq('id', invite.bookId)
              .single();
            
            if (bookError || !bookData) {
              console.error('Book not found:', invite.bookId, bookError);
              toast.error('账本不存在');
              return null;
            }
            
            console.log('Fetched book from cloud:', bookData);
            
            // 创建本地账本对象
            book = {
              id: bookData.id,
              name: bookData.name,
              type: bookData.type,
              createdBy: bookData.created_by,
              createdAt: bookData.created_at,
              currency: bookData.currency || 'CNY',
              members: [],
            };
          }
          
          if (!book) {
            toast.error('账本信息获取失败');
            return null;
          }
          
          if (book.createdBy === userId) {
            console.error('Already the owner of this book');
            toast.error('你是这个账本的创建者');
            return null;
          }
          if (book.members.some(m => m.userId === userId)) {
            console.error('Already a member of this book');
            toast.error('你已经是这个账本的成员');
            return null;
          }

          // 添加成员
          const member: BookMember = {
            userId,
            role: 'MEMBER',
            joinedAt: new Date().toISOString(),
          };

          // 同步云端 - 先执行数据库操作
          const { error: memberError } = await supabase.from('book_members').insert({
            book_id: invite.bookId,
            user_id: userId,
            role: 'MEMBER',
            joined_at: member.joinedAt,
          });

          if (memberError) {
            console.error('Insert member error:', memberError);
            // 检查是否是重复加入的错误
            if (memberError.message?.includes('duplicate') || memberError.code === '23505') {
              toast.error('你已经是这个账本的成员了');
              // 刷新账本列表
              await get().fetchBooks(userId);
              return book;
            }
            toast.error('加入账本失败: ' + memberError.message);
            return null;
          }

          // 更新邀请码使用次数
          const { error: updateError } = await supabase
            .from('book_invites')
            .update({ used_count: invite.usedCount + 1 })
            .eq('id', invite.id);

          if (updateError) {
            console.error('Update invite error:', updateError);
          if (updateError) {
            console.error('Update invite error:', updateError);
          }

          // 更新本地状态
          set(state => ({
            books: state.books.find(b => b.id === invite.bookId)
              ? state.books.map(b =>
                  b.id === invite.bookId
                    ? { ...b, members: [...b.members, member] }
                    : b
                )
              : [...state.books, { ...book!, members: [...book!.members, member] }],
          }));
          
          // 保存到本地数据库
          const updatedBook = {
            ...book!,
            members: [...book!.members, member],
            synced: true,
            lastModified: Date.now(),
          };
          await db.books.put(updatedBook);

          // 刷新账本列表
          await get().fetchBooks(userId);
          
          // 返回新加入的账本
          const finalBook = get().books.find(b => b.id === invite.bookId);
          return finalBook || book;
        } catch (error: any) {
          console.error('Join book by code error:', error);
          toast.error('加入失败: ' + (error?.message || '未知错误'));
          return null;
        }
      },

      // 权限检查
      isBookOwner: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        return book?.createdBy === userId;
      },

      isBookMember: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        return book?.members.some(m => m.userId === userId) || false;
      },

      canModifyBook: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        if (!book) return false;
        // 创建者或管理员可以修改
        if (book.createdBy === userId) return true;
        const member = book.members.find(m => m.userId === userId);
        return member?.role === 'ADMIN' || member?.role === 'OWNER';
      },

      fetchCategories: async (bookId) => {
        } catch (error: any) {
          console.error('Join book by code error:', error);
          toast.error('加入失败: ' + (error?.message || '未知错误'));
          return null;
        }
      },

      // 权限检查
      isBookOwner: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        return book?.createdBy === userId;
      },          toast.error('加入失败: ' + (error?.message || '未知错误'));
          return null;
        }
      },

      // 权限检查
      isBookOwner: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        return book?.createdBy === userId;
      },

      isBookMember: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        return book?.members.some(m => m.userId === userId) || false;
      },

      canModifyBook: (bookId: string, userId: string) => {
        const book = get().books.find(b => b.id === bookId);
        if (!book) return false;
        // 创建者或管理员可以修改
        if (book.createdBy === userId) return true;
        const member = book.members.find(m => m.userId === userId);
        return member?.role === 'ADMIN' || member?.role === 'OWNER';
      },

      fetchCategories: async (bookId) => {
        // 先尝试从云端获取
        try {
          const { data } = await supabase
            .from('categories')
            .select('*')
            .eq('book_id', bookId)
            .order('sort_order');

          if (data && data.length > 0) {
            // 云端有数据，使用云端数据
            const categories: Category[] = (data as any[]).map((c: any) => ({
              id: c.id,
              bookId: c.book_id,
              name: c.name,
              type: c.type as 'INCOME' | 'EXPENSE',
              icon: c.icon,
              color: c.color,
              sortOrder: c.sort_order,
              isBuiltin: c.is_builtin,
            }));

            // 更新本地
            await db.categories.bulkPut(
              categories.map(c => ({ ...c, synced: true, lastModified: Date.now() }))
            );
            set({ categories });
            return;
          }
        } catch (error) {
          console.error('Fetch from cloud error:', error);
        }

        // 云端没有，检查本地
        const localCats = await db.categories.where('bookId').equals(bookId).toArray();
        
        if (localCats.length > 0) {
          // 本地有数据，使用本地数据
          set({ categories: localCats });
        } else {
          // 都没有，创建默认分类
          const defaultCategories = [
            ...BUILTIN_EXPENSE_CATEGORIES.map((cat, index) => ({
              id: crypto.randomUUID(),
              bookId: bookId,
              name: cat.name,
              type: 'EXPENSE' as const,
              icon: cat.icon,
              color: cat.color,
              sortOrder: index,
              isBuiltin: true,
            })),
            ...BUILTIN_INCOME_CATEGORIES.map((cat, index) => ({
              id: crypto.randomUUID(),
              bookId: bookId,
              name: cat.name,
              type: 'INCOME' as const,
              icon: cat.icon,
              color: cat.color,
              sortOrder: index,
              isBuiltin: true,
            })),
          ];

          for (const cat of defaultCategories) {
            await db.categories.put({ ...cat, synced: false, lastModified: Date.now() });
          }
          
          set({ categories: defaultCategories });
          
          // 后台同步到云端
          (async () => {
            try {
              await supabase.from('categories').insert(
                defaultCategories.map(c => ({
                  id: c.id,
                  book_id: c.bookId,
                  name: c.name,
                  type: c.type,
                  icon: c.icon,
                  color: c.color,
                  sort_order: c.sortOrder,
                  is_builtin: c.isBuiltin,
                }))
              );
              for (const cat of defaultCategories) {
                await db.categories.update(cat.id, { synced: true });
              }
            } catch (error) {
              console.error('Sync default categories error:', error);
            }
          })();
        }
      },

      addCategory: async (category) => {
        const { currentBook } = get();
        if (!currentBook) return;

        const cat: Category = {
          id: crypto.randomUUID(),
          bookId: currentBook.id,
          ...category,
        };

        // 存本地
        await db.categories.put({ ...cat, synced: false, lastModified: Date.now() });

        // 更新状态
        await get().fetchCategories(currentBook.id);

        // 后台同步云端（不阻塞）
        (async () => {
          try {
            await supabase.from('categories').insert({
              id: cat.id,
              book_id: cat.bookId,
              name: cat.name,
              type: cat.type,
              icon: cat.icon,
              color: cat.color,
              sort_order: cat.sortOrder || 99,
              is_builtin: false,
            });
            await db.categories.update(cat.id, { synced: true });
          } catch (error) {
            console.error('Add category sync error:', error);
          }
        })();
      },

      updateCategory: async (categoryId, data) => {
        const { currentBook } = get();
        if (!currentBook) return;

        // 更新本地
        await db.categories.update(categoryId, {
          ...data,
          synced: false,
          lastModified: Date.now(),
        });

        await get().fetchCategories(currentBook.id);

        // 后台同步云端（不阻塞）
        (async () => {
          try {
            const updateData: any = {};
            if (data.name) updateData.name = data.name;
            if (data.icon) updateData.icon = data.icon;
            if (data.color) updateData.color = data.color;
            if (data.sortOrder !== undefined) updateData.sort_order = data.sortOrder;

            await supabase.from('categories').update(updateData).eq('id', categoryId);
            await db.categories.update(categoryId, { synced: true });
          } catch (error) {
            console.error('Update category sync error:', error);
          }
        })();
      },

      deleteCategory: async (categoryId) => {
        const { currentBook } = get();
        if (!currentBook) return;

        // 删除本地
        await db.categories.delete(categoryId);
        await get().fetchCategories(currentBook.id);

        // 后台同步云端（不阻塞）
        (async () => {
          try {
            await supabase.from('categories').delete().eq('id', categoryId);
          } catch (error) {
            console.error('Delete category sync error:', error);
          }
        })();
      },

      getCategoriesByType: (type) => {
        const { currentBook, categories } = get();
        if (!currentBook) return [];
        return categories
          .filter(cat => cat.bookId === currentBook.id && cat.type === type)
          .sort((a, b) => a.sortOrder - b.sortOrder);
      },

      initDefaultBook: async (userId) => {
        const { books } = get();
        // 只检查当前用户的个人账本
        const userPersonalBooks = books.filter(
          b => b.createdBy === userId && b.type === 'PERSONAL'
        );
        
        if (userPersonalBooks.length === 0) {
          await get().createBook('个人账本', 'PERSONAL', userId);
        }
      },
    }),
    {
      name: 'book-store',
      // 优化：只持久化必要数据，deletedBookIds 需要特殊处理 Set 类型
      partialize: (state) => ({
        currentBook: state.currentBook,
        deletedBookIds: Array.from(state.deletedBookIds),
      }),
      storage: {
        getItem: async (name) => {
          const value = await storage.get<string>(name);
          return value ? JSON.parse(value) : null;
        },
        setItem: async (name, value) => {
          await storage.set(name, JSON.stringify(value));
        },
        removeItem: async (name) => {
          await storage.remove(name);
        },
      },
      onRehydrateStorage: () => (state) => {
        // 恢复时将数组转回 Set
        if (state && state.deletedBookIds) {
          state.deletedBookIds = new Set(state.deletedBookIds);
        }
      },
    }
  )
);
